<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:clipToPadding="false"
    android:fillViewport="true"
    android:scrollbars="none">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="@dimen/content_gutter"
        android:paddingTop="24dp"
        android:paddingEnd="@dimen/content_gutter"
        android:paddingBottom="36dp">

        <TextView
            style="@style/TextAppearance.PocketDesk.Display"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/settings_title" />

        <TextView
            style="@style/TextAppearance.PocketDesk.Body"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/settings_subtitle"
            android:textSize="15sp" />

        <TextView
            style="@style/TextAppearance.PocketDesk.Section"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:layout_marginBottom="8dp"
            android:text="@string/settings_stream" />

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardBackgroundColor="?attr/colorSurface"
            app:cardCornerRadius="24dp"
            app:cardElevation="0dp"
            app:strokeColor="?attr/colorOutline"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <LinearLayout
                    android:id="@+id/settingsQuality"
                    style="@style/Widget.PocketDesk.Row">

                    <ImageView
                        style="@style/Widget.PocketDesk.RowIcon"
                        android:contentDescription="@null"
                        android:src="@drawable/ic_screen" />

                    <TextView
                        style="@style/Widget.PocketDesk.RowTitle"
                        android:text="@string/settings_quality" />

                    <TextView
                        android:id="@+id/settingsQualityValue"
                        style="@style/Widget.PocketDesk.RowValue" />

                    <ImageView
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:layout_marginStart="6dp"
                        android:contentDescription="@null"
                        android:src="@drawable/ic_chevron"
                        android:tint="?attr/colorOnSurfaceVariant" />
                </LinearLayout>

                <View style="@style/Widget.PocketDesk.Divider" />

                <LinearLayout
                    android:id="@+id/settingsScreen"
                    style="@style/Widget.PocketDesk.Row">

                    <ImageView
                        style="@style/Widget.PocketDesk.RowIcon"
                        android:contentDescription="@null"
                        android:src="@drawable/ic_devices" />

                    <TextView
                        style="@style/Widget.PocketDesk.RowTitle"
                        android:text="@string/settings_screen" />

                    <TextView
                        android:id="@+id/settingsScreenValue"
                        style="@style/Widget.PocketDesk.RowValue" />

                    <ImageView
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:layout_marginStart="6dp"
                        android:contentDescription="@null"
                        android:src="@drawable/ic_chevron"
                        android:tint="?attr/colorOnSurfaceVariant" />
                </LinearLayout>

                <View style="@style/Widget.PocketDesk.Divider" />

                <LinearLayout
                    android:id="@+id/settingsInput"
                    style="@style/Widget.PocketDesk.Row">

                    <ImageView
                        style="@style/Widget.PocketDesk.RowIcon"
                        android:contentDescription="@null"
                        android:src="@drawable/ic_keyboard" />

                    <TextView
                        style="@style/Widget.PocketDesk.RowTitle"
                        android:text="@string/settings_input" />

                    <TextView
                        android:id="@+id/settingsInputValue"
                        style="@style/Widget.PocketDesk.RowValue" />

                    <ImageView
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:layout_marginStart="6dp"
                        android:contentDescription="@null"
                        android:src="@drawable/ic_chevron"
                        android:tint="?attr/colorOnSurfaceVariant" />
                </LinearLayout>

                <View style="@style/Widget.PocketDesk.Divider" />

                <LinearLayout
                    android:id="@+id/settingsScroll"
                    style="@style/Widget.PocketDesk.Row">

                    <ImageView
                        style="@style/Widget.PocketDesk.RowIcon"
                        android:contentDescription="@null"
                        android:src="@drawable/ic_update" />

                    <TextView
                        style="@style/Widget.PocketDesk.RowTitle"
                        android:text="@string/settings_scroll" />

                    <TextView
                        android:id="@+id/settingsScrollValue"
                        style="@style/Widget.PocketDesk.RowValue" />

                    <ImageView
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:layout_marginStart="6dp"
                        android:contentDescription="@null"
                        android:src="@drawable/ic_chevron"
                        android:tint="?attr/colorOnSurfaceVariant" />
                </LinearLayout>

                <View style="@style/Widget.PocketDesk.Divider" />

                <LinearLayout
                    android:id="@+id/settingsAudio"
                    style="@style/Widget.PocketDesk.Row">

                    <ImageView
                        style="@style/Widget.PocketDesk.RowIcon"
                        android:contentDescription="@null"
                        android:src="@drawable/ic_volume" />

                    <TextView
                        style="@style/Widget.PocketDesk.RowTitle"
                        android:text="@string/settings_audio" />

                    <TextView
                        android:id="@+id/settingsAudioValue"
                        style="@style/Widget.PocketDesk.RowValue" />

                    <ImageView
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:layout_marginStart="6dp"
                        android:contentDescription="@null"
                        android:src="@drawable/ic_chevron"
                        android:tint="?attr/colorOnSurfaceVariant" />
                </LinearLayout>

                <View style="@style/Widget.PocketDesk.Divider" />

                <LinearLayout
                    android:id="@+id/settingsKeys"
                    style="@style/Widget.PocketDesk.Row">

                    <ImageView
                        style="@style/Widget.PocketDesk.RowIcon"
                        android:contentDescription="@null"
                        android:src="@drawable/ic_keyboard" />

                    <TextView
                        style="@style/Widget.PocketDesk.RowTitle"
                        android:text="@string/settings_keys" />

                    <TextView
                        android:id="@+id/settingsKeysValue"
                        style="@style/Widget.PocketDesk.RowValue" />

                    <ImageView
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:layout_marginStart="6dp"
                        android:contentDescription="@null"
                        android:src="@drawable/ic_chevron"
                        android:tint="?attr/colorOnSurfaceVariant" />
                </LinearLayout>

                <View style="@style/Widget.PocketDesk.Divider" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="60dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingStart="18dp"
                    android:paddingEnd="14dp">

                    <ImageView
                        style="@style/Widget.PocketDesk.RowIcon"
                        android:contentDescription="@null"
                        android:src="@drawable/ic_devices" />

                    <TextView
                        style="@style/Widget.PocketDesk.RowTitle"
                        android:text="@string/settings_second" />

                    <com.google.android.material.switchmaterial.SwitchMaterial
                        android:id="@+id/settingsSecondSwitch"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:contentDescription="@string/settings_second" />
                </LinearLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <TextView
            style="@style/TextAppearance.PocketDesk.Section"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:layout_marginBottom="8dp"
            android:text="@string/settings_app" />

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardBackgroundColor="?attr/colorSurface"
            app:cardCornerRadius="24dp"
            app:cardElevation="0dp"
            app:strokeColor="?attr/colorOutline"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <LinearLayout
                    android:id="@+id/settingsUpdates"
                    style="@style/Widget.PocketDesk.Row">

                    <ImageView
                        style="@style/Widget.PocketDesk.RowIcon"
                        android:contentDescription="@null"
                        android:src="@drawable/ic_update" />

                    <TextView
                        style="@style/Widget.PocketDesk.RowTitle"
                        android:text="@string/settings_updates" />

                    <ImageView
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:contentDescription="@null"
                        android:src="@drawable/ic_chevron"
                        android:tint="?attr/colorOnSurfaceVariant" />
                </LinearLayout>

                <View style="@style/Widget.PocketDesk.Divider" />

                <LinearLayout
                    android:id="@+id/settingsSource"
                    style="@style/Widget.PocketDesk.Row">

                    <ImageView
                        style="@style/Widget.PocketDesk.RowIcon"
                        android:contentDescription="@null"
                        android:src="@drawable/ic_devices" />

                    <TextView
                        style="@style/Widget.PocketDesk.RowTitle"
                        android:text="@string/settings_source" />

                    <ImageView
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:contentDescription="@null"
                        android:src="@drawable/ic_chevron"
                        android:tint="?attr/colorOnSurfaceVariant" />
                </LinearLayout>

                <View style="@style/Widget.PocketDesk.Divider" />

                <LinearLayout
                    style="@style/Widget.PocketDesk.Row">

                    <ImageView
                        style="@style/Widget.PocketDesk.RowIcon"
                        android:contentDescription="@null"
                        android:src="@drawable/ic_settings" />

                    <TextView
                        style="@style/Widget.PocketDesk.RowTitle"
                        android:text="@string/settings_version" />

                    <TextView
                        android:id="@+id/settingsVersion"
                        style="@style/Widget.PocketDesk.RowValue" />
                </LinearLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
