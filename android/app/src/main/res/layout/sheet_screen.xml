<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:scrollbars="none">

<LinearLayout
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingStart="24dp"
    android:paddingTop="8dp"
    android:paddingEnd="24dp"
    android:paddingBottom="20dp">

    <TextView
        style="@style/TextAppearance.PocketDesk.Title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/screen_mode_title" />

    <TextView
        style="@style/TextAppearance.PocketDesk.Body"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="@string/screen_sheet_subtitle"
        android:textSize="13sp" />

    <RadioGroup
        android:id="@+id/screenGroup"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:orientation="vertical">

        <com.google.android.material.radiobutton.MaterialRadioButton
            android:id="@+id/screenFit"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="48dp"
            android:text="@string/screen_fit" />

        <com.google.android.material.radiobutton.MaterialRadioButton
            android:id="@+id/screenFill"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="48dp"
            android:text="@string/screen_fill" />

        <com.google.android.material.radiobutton.MaterialRadioButton
            android:id="@+id/screenStretch"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="48dp"
            android:text="@string/screen_stretch" />
    </RadioGroup>
</LinearLayout>
</androidx.core.widget.NestedScrollView>
