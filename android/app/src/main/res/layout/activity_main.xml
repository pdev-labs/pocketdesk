<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg">

    <!-- ── Pairing / connection ─────────────────────────────────────── -->
    <ScrollView
        android:id="@+id/connectScroll"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        android:scrollbars="none">

        <LinearLayout
            android:id="@+id/connectPanel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:paddingStart="24dp"
            android:paddingTop="56dp"
            android:paddingEnd="24dp"
            android:paddingBottom="40dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:letterSpacing="-0.03"
                android:text="@string/app_name"
                android:textColor="@color/text"
                android:textSize="34sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="@string/tagline"
                android:textColor="@color/muted"
                android:textSize="15sp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="28dp"
                android:background="@drawable/bg_card"
                android:orientation="vertical"
                android:padding="20dp">

                <TextView
                    style="@style/FieldLabel"
                    android:text="HOST OR IP" />

                <EditText
                    android:id="@+id/hostField"
                    style="@style/FieldInput"
                    android:hint="192.168.1.20"
                    android:importantForAutofill="no"
                    android:inputType="textUri" />

                <TextView
                    style="@style/FieldLabel"
                    android:layout_marginTop="16dp"
                    android:text="PORT" />

                <EditText
                    android:id="@+id/portField"
                    style="@style/FieldInput"
                    android:importantForAutofill="no"
                    android:inputType="number"
                    android:text="8765" />

                <TextView
                    style="@style/FieldLabel"
                    android:layout_marginTop="16dp"
                    android:text="PAIRING TOKEN" />

                <EditText
                    android:id="@+id/tokenField"
                    style="@style/FieldInput"
                    android:hint="printed by the host"
                    android:importantForAutofill="no"
                    android:inputType="textVisiblePassword|textNoSuggestions" />

                <Button
                    android:id="@+id/connectButton"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:layout_marginTop="22dp"
                    android:background="@drawable/bg_btn_primary"
                    android:stateListAnimator="@null"
                    android:text="Connect"
                    android:textAllCaps="false"
                    android:textColor="@color/on_accent"
                    android:textSize="16sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <TextView
                android:id="@+id/statusText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:gravity="center"
                android:lineSpacingExtra="2dp"
                android:text="Ready when you are."
                android:textColor="@color/muted"
                android:textSize="13sp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:gravity="center"
                android:lineSpacingExtra="3dp"
                android:text="@string/hint_footer"
                android:textColor="@color/faint"
                android:textSize="12sp" />
        </LinearLayout>
    </ScrollView>

    <!-- ── Remote desktop ───────────────────────────────────────────── -->
    <FrameLayout
        android:id="@+id/remotePanel"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#000000"
        android:visibility="gone">

        <dev.pocketdesk.ui.ScreenView
            android:id="@+id/screenView"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:contentDescription="@string/screen_desc" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="top"
            android:background="@drawable/bg_toolbar"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="8dp"
            android:paddingTop="6dp"
            android:paddingEnd="10dp"
            android:paddingBottom="6dp">

            <HorizontalScrollView
                android:id="@+id/toolbarScroll"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:scrollbars="none">

                <LinearLayout
                    android:id="@+id/toolbarButtons"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal" />
            </HorizontalScrollView>

            <TextView
                android:id="@+id/statsText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:gravity="end"
                android:maxLines="2"
                android:textColor="@color/muted"
                android:textSize="11sp" />
        </LinearLayout>

        <dev.pocketdesk.ui.KeySinkEditText
            android:id="@+id/keySink"
            android:layout_width="1dp"
            android:layout_height="1dp"
            android:alpha="0.01"
            android:background="@null"
            android:importantForAutofill="no"
            android:inputType="textVisiblePassword|textNoSuggestions" />
    </FrameLayout>

</FrameLayout>
