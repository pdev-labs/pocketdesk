<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg">

    <!-- ── Tabs (hidden while a session is live) ─────────────────────── -->
    <LinearLayout
        android:id="@+id/appShell"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <FrameLayout
            android:id="@+id/tabFrame"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">

            <include
                android:id="@+id/homeTab"
                layout="@layout/tab_home"
                android:layout_width="match_parent"
                android:layout_height="match_parent" />

            <include
                android:id="@+id/devicesTab"
                layout="@layout/tab_devices"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:visibility="gone" />

            <include
                android:id="@+id/settingsTab"
                layout="@layout/tab_settings"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:visibility="gone" />
        </FrameLayout>

        <com.google.android.material.bottomnavigation.BottomNavigationView
            android:id="@+id/bottomNav"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="?attr/colorSurface"
            app:itemIconTint="?attr/colorOnSurfaceVariant"
            app:itemTextColor="?attr/colorOnSurfaceVariant"
            app:labelVisibilityMode="labeled"
            app:menu="@menu/menu_bottom_nav" />
    </LinearLayout>

    <!-- ── Remote desktop ────────────────────────────────────────────── -->
    <FrameLayout
        android:id="@+id/remotePanel"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/stream_bg"
        android:visibility="gone">

        <dev.pocketdesk.ui.ScreenView
            android:id="@+id/screenView"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:contentDescription="@string/screen_desc" />

        <dev.pocketdesk.ui.KeySinkEditText
            android:id="@+id/keySink"
            android:layout_width="1dp"
            android:layout_height="1dp"
            android:alpha="0.01"
            android:background="@null"
            android:importantForAutofill="no"
            android:inputType="text|textNoSuggestions" />

        <!-- Floating session pill: keys, modifiers and the session sheet. -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="top"
            android:layout_marginStart="12dp"
            android:layout_marginTop="10dp"
            android:layout_marginEnd="12dp"
            app:cardBackgroundColor="@color/toolbar_bg"
            app:cardCornerRadius="26dp"
            app:cardElevation="10dp"
            app:strokeColor="@color/toolbar_stroke"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="6dp"
                android:paddingTop="5dp"
                android:paddingEnd="10dp"
                android:paddingBottom="5dp">

                <HorizontalScrollView
                    android:id="@+id/toolbarScroll"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:scrollbars="none">

                    <LinearLayout
                        android:id="@+id/toolbarButtons"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal" />
                </HorizontalScrollView>

                <TextView
                    android:id="@+id/statsText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:gravity="end"
                    android:maxLines="1"
                    android:textColor="@color/muted"
                    android:textSize="10sp" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Brings the pill back after it fades out (or after Hide toolbar). -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/toolbarHandle"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:layout_gravity="top|end"
            android:layout_marginTop="10dp"
            android:layout_marginEnd="12dp"
            android:alpha="0.82"
            android:clickable="true"
            android:contentDescription="@string/show_toolbar"
            android:focusable="true"
            app:cardBackgroundColor="@color/toolbar_bg"
            app:cardCornerRadius="22dp"
            app:cardElevation="8dp"
            app:strokeColor="@color/toolbar_stroke"
            app:strokeWidth="1dp"
            android:visibility="gone">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center"
                android:text="☰"
                android:textColor="@color/text"
                android:textSize="16sp" />
        </com.google.android.material.card.MaterialCardView>
    </FrameLayout>
</FrameLayout>
