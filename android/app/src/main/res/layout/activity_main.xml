<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg">

    <!-- ── Pairing / connection ─────────────────────────────────────── -->
    <ScrollView
        android:id="@+id/connectScroll"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        android:scrollbars="none">

        <LinearLayout
            android:id="@+id/connectPanel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:paddingStart="24dp"
            android:paddingTop="48dp"
            android:paddingEnd="24dp"
            android:paddingBottom="40dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:letterSpacing="-0.03"
                android:text="@string/app_name"
                android:textColor="@color/text"
                android:textSize="34sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="@string/tagline"
                android:textColor="@color/muted"
                android:textSize="15sp" />

            <Button
                android:id="@+id/scanButton"
                android:layout_width="match_parent"
                android:layout_height="54dp"
                android:layout_marginTop="26dp"
                android:background="@drawable/bg_btn_primary"
                android:stateListAnimator="@null"
                android:text="@string/scan_qr"
                android:textAllCaps="false"
                android:textColor="@color/on_accent"
                android:textSize="16sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:text="@string/or_manual"
                android:textColor="@color/faint"
                android:textSize="12sp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:background="@drawable/bg_card"
                android:orientation="vertical"
                android:padding="20dp">

                <TextView
                    style="@style/FieldLabel"
                    android:text="HOST OR IP" />

                <EditText
                    android:id="@+id/hostField"
                    style="@style/FieldInput"
                    android:hint="192.168.1.20"
                    android:importantForAutofill="no"
                    android:inputType="textUri" />

                <TextView
                    style="@style/FieldLabel"
                    android:layout_marginTop="14dp"
                    android:text="PORT" />

                <EditText
                    android:id="@+id/portField"
                    style="@style/FieldInput"
                    android:importantForAutofill="no"
                    android:inputType="number"
                    android:text="8765" />

                <TextView
                    style="@style/FieldLabel"
                    android:layout_marginTop="14dp"
                    android:text="PAIRING CODE" />

                <EditText
                    android:id="@+id/tokenField"
                    style="@style/FieldInput"
                    android:hint="K7M4-QX2B"
                    android:importantForAutofill="no"
                    android:inputType="textVisiblePassword|textNoSuggestions|textCapCharacters"
                    android:maxLength="128" />

                <CheckBox
                    android:id="@+id/rememberBox"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:buttonTint="@color/accent"
                    android:checked="true"
                    android:text="@string/remember_device"
                    android:textColor="@color/text"
                    android:textSize="14sp" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:lineSpacingExtra="2dp"
                    android:text="@string/remember_hint"
                    android:textColor="@color/faint"
                    android:textSize="11sp" />

                <Button
                    android:id="@+id/connectButton"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:layout_marginTop="18dp"
                    android:background="@drawable/bg_btn_primary"
                    android:stateListAnimator="@null"
                    android:text="Connect"
                    android:textAllCaps="false"
                    android:textColor="@color/on_accent"
                    android:textSize="16sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/recentRow"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:background="@drawable/bg_card"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="18dp"
                android:paddingTop="14dp"
                android:paddingEnd="12dp"
                android:paddingBottom="14dp"
                android:visibility="gone">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        style="@style/FieldLabel"
                        android:text="@string/recent_label" />

                    <TextView
                        android:id="@+id/recentHost"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:textColor="@color/text"
                        android:textSize="14sp" />
                </LinearLayout>

                <TextView
                    android:id="@+id/recentConnect"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_chip"
                    android:clickable="true"
                    android:focusable="true"
                    android:paddingStart="14dp"
                    android:paddingTop="9dp"
                    android:paddingEnd="14dp"
                    android:paddingBottom="9dp"
                    android:text="@string/reconnect"
                    android:textColor="@color/accent"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/recentForget"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:background="?android:attr/selectableItemBackgroundBorderless"
                    android:clickable="true"
                    android:focusable="true"
                    android:padding="8dp"
                    android:text="@string/forget"
                    android:textColor="@color/muted"
                    android:textSize="13sp" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/updateRow"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:background="@drawable/bg_card"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="18dp"
                android:paddingTop="14dp"
                android:paddingEnd="12dp"
                android:paddingBottom="14dp"
                android:visibility="gone">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/updateTitle"
                        style="@style/FieldLabel"
                        android:text="@string/update_available" />

                    <TextView
                        android:id="@+id/updateDetail"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:textColor="@color/text"
                        android:textSize="13sp" />
                </LinearLayout>

                <TextView
                    android:id="@+id/updateLater"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="?android:attr/selectableItemBackgroundBorderless"
                    android:clickable="true"
                    android:focusable="true"
                    android:padding="8dp"
                    android:text="@string/update_later"
                    android:textColor="@color/muted"
                    android:textSize="13sp" />

                <TextView
                    android:id="@+id/updateAction"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:background="@drawable/bg_chip"
                    android:clickable="true"
                    android:focusable="true"
                    android:paddingStart="14dp"
                    android:paddingTop="9dp"
                    android:paddingEnd="14dp"
                    android:paddingBottom="9dp"
                    android:text="@string/update_install"
                    android:textColor="@color/accent"
                    android:textSize="13sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <TextView
                android:id="@+id/statusText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:gravity="center"
                android:lineSpacingExtra="2dp"
                android:text="Ready when you are."
                android:textColor="@color/muted"
                android:textSize="13sp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:gravity="center"
                android:lineSpacingExtra="3dp"
                android:text="@string/hint_footer"
                android:textColor="@color/faint"
                android:textSize="12sp" />
        </LinearLayout>
    </ScrollView>

    <!-- ── Remote desktop ───────────────────────────────────────────── -->
    <FrameLayout
        android:id="@+id/remotePanel"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#000000"
        android:visibility="gone">

        <dev.pocketdesk.ui.ScreenView
            android:id="@+id/screenView"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:contentDescription="@string/screen_desc" />

        <LinearLayout
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="top"
            android:background="@drawable/bg_toolbar"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="8dp"
            android:paddingTop="6dp"
            android:paddingEnd="10dp"
            android:paddingBottom="6dp">

            <HorizontalScrollView
                android:id="@+id/toolbarScroll"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:scrollbars="none">

                <LinearLayout
                    android:id="@+id/toolbarButtons"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal" />
            </HorizontalScrollView>

            <TextView
                android:id="@+id/statsText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:gravity="end"
                android:maxLines="2"
                android:textColor="@color/muted"
                android:textSize="11sp" />
        </LinearLayout>

        <dev.pocketdesk.ui.KeySinkEditText
            android:id="@+id/keySink"
            android:layout_width="1dp"
            android:layout_height="1dp"
            android:alpha="0.01"
            android:background="@null"
            android:importantForAutofill="no"
            android:inputType="textVisiblePassword|textNoSuggestions" />

        <!-- Small tab that brings the toolbar back when it is hidden for a
             full-screen view (see the ⋯ → Hide toolbar action). -->
        <TextView
            android:id="@+id/toolbarHandle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="top|end"
            android:layout_marginTop="8dp"
            android:layout_marginEnd="8dp"
            android:alpha="0.75"
            android:background="@drawable/bg_chip_dim"
            android:clickable="true"
            android:contentDescription="@string/show_toolbar"
            android:focusable="false"
            android:paddingStart="12dp"
            android:paddingTop="7dp"
            android:paddingEnd="12dp"
            android:paddingBottom="7dp"
            android:text="☰"
            android:textColor="@color/text"
            android:textSize="15sp"
            android:visibility="gone" />
    </FrameLayout>

</FrameLayout>
